+func (c fiber.Ctx) NoContent() error
+func (r fiber.Res) NoContent() error
+```
+
+```go title="Example"
+app.Delete("/item/:id", func(c fiber.Ctx) error {
+  if err := delete(c.Params("id")); err != nil {
+    return err
+  }
+
+  return c.NoContent() // => 204, no body
+})
+```
