+	case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9':
+		// "\d", "\w", "\p{Greek}", "\b" — a class or an assertion. Measured as
+		// two bytes even where it runs longer, which only ends the prefix sooner.
+		return 2, false
+	default:
+		return 2, true
+	}
