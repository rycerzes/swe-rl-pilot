+		if s[i] != '%' || i+2 >= len(s) {
+			decoded = append(decoded, s[i])
+			continue
+		}
+		hi, hiOK := unhex(s[i+1])
+		lo, loOK := unhex(s[i+2])
+		if !hiOK || !loOK {
+			decoded = append(decoded, s[i])
