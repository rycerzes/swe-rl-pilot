-		return false
-	}
-	inPath := true
-	var prev byte
-	for i := 0; i < len(requestPath); i++ {
-		c := requestPath[i]
-		if (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') {
-			prev = c
-			continue
-		}
