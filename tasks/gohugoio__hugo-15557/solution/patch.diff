+// zeroOf returns the zero value of v's concrete type, looking through interfaces.
+func zeroOf(v reflect.Value) any {
+	for v.Kind() == reflect.Interface {
+		if v.IsNil() {
+			return nil
+		}
+		v = v.Elem()
+	}
+	return reflect.Zero(v.Type()).Interface()
+}
